# BocchiMaster — environment template. Copy to `.env` (gitignored).

# AudioChord (15_AudioChord) API key for X-AC-Key header.
# - Empty / unset → no header sent → AudioChord falls back to no-auth mode.
# - After Herta admin runs `setx /M AC_API_KEY <value>` and restarts AudioChord
#   Servy, copy the same value here. Frontend must rebuild (`npm run build`)
#   because Vite inlines VITE_* vars at build time.
VITE_AC_API_KEY=

# AudioChord web UI opened from Practice Home ("AudioChord 가져오기" button).
# Unset → defaults to the Herta Tailscale address below.
#VITE_AC_UI_URL=http://100.111.55.55:8220/ui
